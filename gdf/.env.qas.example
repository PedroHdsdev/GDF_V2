# Ambiente QAS - homo.processit.com.br
# Copie para gdf/.env no servidor e substitua todos os placeholders.
# Nunca versione o arquivo com valores reais.

APP_ENV=qas
DEBUG=False
SECRET_KEY=SUBSTITUA_POR_CHAVE_DJANGO_ALEATORIA
ALLOWED_HOSTS=homo.processit.com.br,localhost,127.0.0.1

# PostgreSQL QAS externo ao Docker
DB_ENGINE=django.db.backends.postgresql
DB_NAME=GDF_QAS
DB_USER=USUARIO_QAS
DB_PASSWORD=SENHA_QAS
DB_HOST=HOST_POSTGRES_QAS
DB_PORT=5432

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CERT_PASSWORD_FERNET_KEY=SUBSTITUA_POR_CHAVE_FERNET

# Publicacao pelo Nginx
FORCE_SCRIPT_NAME=/gdf
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://homo.processit.com.br
STREAMLIT_BASE_URL=https://homo.processit.com.br/gdf/streamlit
CSP_FRAME_SRC_EXTRA=https://homo.processit.com.br
CSP_CONNECT_SRC_EXTRA=https://cdn.jsdelivr.net

# O Compose substitui estas URLs para os nomes dos servicos Docker.
# Nao use localhost para Redis dentro dos containers.
GUNICORN_TIMEOUT=150
GUNICORN_KEEPALIVE=2
GUNICORN_LOGLEVEL=info

# Integracao SAP QAS
SAP_RELATORIO_CUSTO_API_KEY=SUBSTITUA_POR_CHAVE_SAP
SAP_CONSULTA_FISCAL_MATERIAL_URL=https://HOST_SAP_QAS/endpoint
SAP_CONSULTA_FISCAL_MATERIAL_AUTH_MODE=none
SAP_CONSULTA_FISCAL_MATERIAL_TIMEOUT=25

# Limites operacionais
RATE_LIMIT_DISABLED=False
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_GENERAL_MAX=100
